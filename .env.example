# Copie para .env. Nunca versione sua chave.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Modelo alternativo em caso de indisponibilidade do principal.
# Deixe vazio para desativar a alternância.
GEMINI_FALLBACK_MODELS=gemini-3.7-flash
# Intervalo mínimo entre chamadas; ajuste conforme as cotas do AI Studio.
GEMINI_REQUEST_INTERVAL=15
DATA_DIR=data
# Aplicação local para demonstração. Não exponha sem autenticação.
